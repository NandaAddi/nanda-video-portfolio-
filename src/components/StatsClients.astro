---
import { portfolioData } from '../data/portfolio';

const { stats, brands } = portfolioData;
---

<section id="stats" class="stats-section">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">Dampak & Kolaborasi</span>
      <h2 class="section-title">Pencapaian & Klien Terpercaya</h2>
      <p class="section-description">
        Kombinasi kreativitas visual, pemahaman storytelling, dan eksekusi teknis presisi untuk menghasilkan dampak nyata.
      </p>
    </div>

    <!-- 4 Stats Cards Grid -->
    <div class="stats-grid">
      {stats.map((stat) => (
        <div class="stat-card">
          <div class="stat-value-group">
            <span class="stat-value">{stat.value}</span>
          </div>
          <h3 class="stat-label">{stat.label}</h3>
          <p class="stat-desc">{stat.description}</p>
        </div>
      ))}
    </div>

    <!-- Brands & Collaborators Grid -->
    <div class="brands-container">
      <p class="brands-heading">Berkolaborasi dengan Kreator & Organisasi</p>
      <div class="brands-list">
        {brands.map((brand) => (
          <div class="brand-badge">
            <span class="brand-dot">✦</span>
            <span class="brand-text">{brand}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .stats-section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    position: relative;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 960px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(2, 132, 199, 0.12);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 30px -4px rgba(2, 132, 199, 0.15);
    border-color: rgba(2, 132, 199, 0.28);
  }

  .stat-value-group {
    margin-bottom: 0.5rem;
  }

  .stat-value {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-blue);
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .stat-desc {
    font-size: 0.85rem;
    color: var(--text-dim);
    line-height: 1.45;
  }

  /* Brands / Collaborators */
  .brands-container {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(10px);
    border: 1px dashed rgba(2, 132, 199, 0.2);
    border-radius: var(--radius-xl);
    padding: 2rem 1.75rem;
    text-align: center;
  }

  .brands-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .brands-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .brand-badge:hover {
    transform: translateY(-2px);
    border-color: var(--accent-blue);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15);
  }

  .brand-dot {
    color: var(--accent-blue);
    font-size: 0.75rem;
  }

  .brand-text {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text-main);
  }
</style>
