---
import type { VideoModalTranslations } from '../data/locales/types';

interface Props {
  modal?: VideoModalTranslations;
}

const {
  modal = {
    closeAria: 'Close video player',
    watchOnYoutube: 'Watch on YouTube',
  },
} = Astro.props;
---

<div id="videoModal" class="yt-modal-backdrop" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true">
  
  <!-- Light Editorial Frosted Top Navigation Bar -->
  <header class="yt-topbar">
    <div class="yt-topbar-left">
      <span class="yt-studio-badge font-mono">STUDIO</span>
      <span class="yt-topbar-divider">/</span>
      <span id="modalClientBreadcrumb" class="yt-client-breadcrumb font-mono">Project Showcase</span>
    </div>

    <button id="modalCloseBtn" class="yt-close-btn" aria-label={modal.closeAria} type="button">
      <span class="yt-close-label font-mono" id="modalCloseLabel">Tutup (Esc)</span>
      <div class="yt-close-icon-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </div>
    </button>
  </header>

  <!-- Full-Screen Scrollable Canvas Area -->
  <div class="yt-modal-scroll" id="ytModalScroll">
    <div class="yt-stage-container">
      
      <!-- 2-Column YouTube Layout Grid -->
      <div class="yt-layout-grid" id="ytLayoutGrid">

        <!-- Video Player Frame -->
        <div class="yt-player-frame" id="modalPlayerFrame">
          <div class="yt-player-aspect" id="modalPlayerAspect">
            <iframe 
              id="modalVideoIframe"
              src="" 
              title="Video Player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <!-- Video Details Card (Editorial Frosted Glass) -->
        <article class="yt-details-box" id="modalDetailsBox">
          <div class="yt-details-header">
            <div class="yt-title-group">
              <span id="modalClientTag" class="yt-client-tag font-mono">KLIEN / KATEGORI</span>
              <h1 id="modalProjectTitle" class="yt-project-title">Judul Karya Portofolio</h1>
            </div>
            <div id="modalToolsTags" class="yt-tools-list">
              <!-- Software tags dynamically injected here -->
            </div>
          </div>

          <!-- Mobile Drop-up / Drop-down Accordion Bar -->
          <button type="button" class="yt-desc-toggle-bar" id="modalDescToggleBtn" aria-expanded="true" aria-controls="modalDescCollapse">
            <div class="yt-desc-toggle-left">
              <span class="yt-desc-toggle-label font-mono">Deskripsi Proyek</span>
              <span class="yt-desc-toggle-pill font-mono" id="modalDescTogglePill">Sembunyikan</span>
            </div>
            <div class="yt-desc-chevron-box">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="yt-desc-chevron">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>

          <div class="yt-divider" id="modalDescDivider"></div>

          <div class="yt-details-collapse is-expanded" id="modalDescCollapse">
            <div class="yt-details-body">
              <p id="modalProjectDesc" class="yt-project-desc">Deskripsi proyek video...</p>
            </div>
          </div>
        </article>

        <!-- RIGHT COLUMN: YouTube-Style Vertical Playlist Sidebar (~28% / Seperempat Layar) -->
        <aside id="modalPlaylistWrapper" class="yt-playlist-sidebar" style="display: none;">
          <div class="yt-sidebar-card">
            
            <!-- Sidebar Header -->
            <div class="yt-sidebar-header">
              <div class="yt-header-title-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" class="yt-header-icon">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
                <h3 id="modalPlaylistTitle" class="yt-playlist-title font-mono">Koleksi Video</h3>
              </div>
              <span id="modalPlaylistCount" class="yt-playlist-count-pill font-mono">3 Video</span>
            </div>
            
            <p id="modalPlaylistSubtitle" class="yt-sidebar-subtitle">Pilih video di bawah untuk memutar</p>

            <!-- Video Rows List -->
            <div id="modalPlaylistTrack" class="yt-playlist-list">
              <!-- Dynamic YouTube-style video cards injected by JS -->
            </div>

          </div>
        </aside>

      </div>

    </div>
  </div>

</div>

<style is:global>
  /* 1. Modal Overlay & Light Frosted Canvas */
  .yt-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    width: 100vw;
    height: 100vh;
    background: rgba(248, 250, 252, 0.94);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .yt-modal-backdrop.open {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  /* 2. Light Editorial Top Navigation Bar */
  .yt-topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 2.25rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px) saturate(190%);
    -webkit-backdrop-filter: blur(20px) saturate(190%);
    border-bottom: 1px solid rgba(226, 232, 240, 0.85);
    flex-shrink: 0;
    transform: translateY(-16px);
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .yt-modal-backdrop.open .yt-topbar {
    transform: translateY(0);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .yt-topbar {
      padding: 0.8rem 1.25rem;
    }
  }

  .yt-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .yt-studio-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ffffff;
    background: #0f172a;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .yt-topbar-divider {
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .yt-client-breadcrumb {
    font-size: 0.85rem;
    font-weight: 500;
    color: #475569;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Close Pill Button */
  .yt-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(203, 213, 225, 0.85);
    color: #0f172a;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .yt-close-btn:hover {
    background: #ffffff;
    border-color: #0f172a;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  }

  .yt-close-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #0f172a;
    letter-spacing: 0.02em;
  }

  @media (max-width: 480px) {
    .yt-close-label {
      display: none;
    }
    .yt-close-btn {
      padding: 0.45rem;
    }
  }

  .yt-close-icon-wrap {
    width: 26px;
    height: 26px;
    background: rgba(15, 23, 42, 0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0f172a;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .yt-close-btn:hover .yt-close-icon-wrap {
    transform: rotate(90deg);
    background: rgba(15, 23, 42, 0.12);
  }

  /* 3. Scrollable Canvas Area */
  .yt-modal-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
    z-index: 10;
    scroll-behavior: smooth;
    padding: 2rem 2.25rem 5rem 2.25rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(15, 23, 42, 0.2) transparent;
  }

  @media (max-width: 640px) {
    .yt-modal-scroll {
      padding: 1.25rem 1rem 4rem 1rem;
    }
  }

  .yt-modal-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .yt-modal-scroll::-webkit-scrollbar-thumb {
    background: rgba(15, 23, 42, 0.2);
    border-radius: 6px;
  }

  .yt-stage-container {
    max-width: 1460px;
    margin: 0 auto;
    width: 100%;
    transform: translateY(42px) scale(0.975);
    opacity: 0;
    transition: transform 0.48s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .yt-modal-backdrop.open .yt-stage-container {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  /* 4. YouTube-Style 2-Column Grid */
  .yt-layout-grid {
    display: grid;
    grid-template-columns: 1fr 370px;
    grid-template-areas:
      "player sidebar"
      "details sidebar";
    gap: 2rem;
    align-items: start;
    width: 100%;
    transition: all 0.3s ease;
  }

  .yt-player-frame {
    grid-area: player;
  }

  .yt-details-box {
    grid-area: details;
  }

  .yt-playlist-sidebar {
    grid-area: sidebar;
  }

  /* Auto-centering modifier when single video project (Landscape) */
  .yt-layout-grid.is-single-video {
    grid-template-columns: 1fr;
    grid-template-areas:
      "player"
      "details";
    max-width: 1080px;
    margin: 0 auto;
  }

  /* VERTICAL / SHORTS (9:16) MODE: 2-Column with Player on Left and Details on Right */
  .yt-layout-grid.is-vertical-video {
    grid-template-columns: minmax(320px, 420px) minmax(360px, 580px);
    grid-template-areas:
      "player details"
      "player sidebar";
    max-width: 1040px;
    margin: 0 auto;
    gap: 2.25rem;
    align-items: start;
    justify-content: center;
  }

  .yt-layout-grid.is-vertical-video.is-single-video {
    grid-template-columns: minmax(320px, 420px) minmax(360px, 580px);
    grid-template-areas:
      "player details";
    max-width: 1040px;
    margin: 0 auto;
    justify-content: center;
  }

  /* Video Player Aspect Frame */
  .yt-player-frame {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #000000;
    border: 1px solid rgba(15, 23, 42, 0.1);
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.15),
                0 6px 16px -4px rgba(15, 23, 42, 0.06);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .yt-player-aspect {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 widescreen aspect */
    background: #000000;
  }

  .yt-player-aspect iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Vertical / Shorts 9:16 Frame Modifiers */
  .yt-layout-grid.is-vertical-video .yt-player-frame {
    width: 100%;
    max-width: 420px;
    height: 74vh;
    max-height: 740px;
    min-height: 480px;
    aspect-ratio: 9 / 16;
    margin: 0 auto;
    border-radius: 20px;
    box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.2), 0 8px 20px -4px rgba(15, 23, 42, 0.08);
    grid-row: 1 / span 2;
  }

  .yt-layout-grid.is-vertical-video .yt-player-aspect {
    width: 100%;
    height: 100%;
    padding-top: 0;
    aspect-ratio: 9 / 16;
  }

  /* Details Card (Light Editorial Glassmorphism) */
  .yt-details-box {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 18px;
    padding: 1.75rem 2rem;
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.04),
                inset 0 1px 1px rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: all 0.3s ease;
  }

  .yt-layout-grid.is-vertical-video .yt-details-box {
    padding: 2rem 2.25rem;
    border-radius: 20px;
    box-shadow: 0 12px 32px -6px rgba(15, 23, 42, 0.06),
                inset 0 1px 1.5px rgba(255, 255, 255, 0.98);
  }

  @media (max-width: 1024px) {
    .yt-layout-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "player"
        "sidebar"
        "details";
      gap: 1.75rem;
    }

    .yt-layout-grid.is-single-video {
      grid-template-areas:
        "player"
        "details";
    }

    .yt-layout-grid.is-vertical-video {
      grid-template-columns: 1fr;
      grid-template-areas:
        "player"
        "sidebar"
        "details";
      max-width: 480px;
      gap: 1.5rem;
    }

    .yt-layout-grid.is-vertical-video.is-single-video {
      grid-template-areas:
        "player"
        "details";
    }

    .yt-layout-grid.is-vertical-video .yt-player-frame {
      grid-row: auto;
      max-width: 100%;
      height: 68vh;
      max-height: 580px;
      min-height: 400px;
    }

    .yt-sidebar-card {
      position: static;
      top: auto;
    }

    .yt-playlist-list {
      max-height: 360px;
    }
  }

  @media (max-width: 640px) {
    .yt-topbar {
      padding: 0.75rem 1rem;
    }

    .yt-modal-scroll {
      padding: 1rem 0.75rem 3.5rem 0.75rem;
    }

    .yt-sidebar-card {
      padding: 1rem;
      border-radius: 16px;
    }

    .yt-details-box {
      padding: 1.15rem 1rem;
      border-radius: 16px;
      transition: padding 0.3s ease;
    }

    .yt-details-box.is-desc-collapsed {
      padding-bottom: 0.85rem;
    }

    .yt-layout-grid.is-vertical-video .yt-player-frame {
      max-width: 320px;
      height: 60vh;
      max-height: 500px;
      min-height: 360px;
      border-radius: 14px;
    }

    /* Mobile Accordion Toggle Bar */
    .yt-desc-toggle-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      margin-top: 0.85rem;
      padding: 0.55rem 0.8rem;
      background: rgba(15, 23, 42, 0.04);
      border: 1px solid rgba(203, 213, 225, 0.75);
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .yt-desc-toggle-bar:hover,
    .yt-desc-toggle-bar:active {
      background: rgba(15, 23, 42, 0.07);
      border-color: rgba(15, 23, 42, 0.15);
    }

    .yt-desc-toggle-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .yt-desc-toggle-label {
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #334155;
    }

    .yt-desc-toggle-pill {
      font-size: 0.68rem;
      font-weight: 600;
      color: #0f172a;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(203, 213, 225, 0.85);
      padding: 0.12rem 0.5rem;
      border-radius: 4px;
      letter-spacing: 0.02em;
    }

    .yt-desc-chevron-box {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(203, 213, 225, 0.75);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #0f172a;
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
    }

    .yt-desc-chevron {
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* When expanded (drop-up position): chevron points UP */
    .yt-desc-toggle-bar[aria-expanded="true"] .yt-desc-chevron {
      transform: rotate(180deg);
    }

    /* When collapsed (dropdown folded position): chevron points DOWN */
    .yt-desc-toggle-bar[aria-expanded="false"] .yt-desc-chevron {
      transform: rotate(0deg);
    }

    #modalDescDivider {
      margin: 0.85rem 0;
      transition: opacity 0.25s ease, margin 0.25s ease;
    }

    .yt-details-box.is-desc-collapsed #modalDescDivider {
      opacity: 0;
      margin: 0;
      height: 0;
    }

    /* Collapsible content container with smooth height & opacity transition */
    .yt-details-collapse {
      overflow: hidden;
      transition: max-height 0.38s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.28s ease,
                  transform 0.28s ease;
      will-change: max-height, opacity, transform;
    }

    .yt-details-collapse.is-expanded {
      max-height: 1200px;
      opacity: 1;
      transform: translateY(0);
    }

    .yt-details-collapse.is-collapsed {
      max-height: 0;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
    }
  }

  .yt-details-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .yt-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 780px;
  }

  .yt-client-tag {
    font-size: 0.76rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .yt-project-title {
    font-size: 1.55rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.25;
    margin: 0;
  }

  @media (max-width: 640px) {
    .yt-project-title {
      font-size: 1.25rem;
    }
  }

  .yt-tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .yt-tool-chip {
    font-size: 0.74rem;
    font-weight: 500;
    color: #334155;
    background: rgba(15, 23, 42, 0.04);
    border: 1px solid rgba(203, 213, 225, 0.8);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .yt-divider {
    height: 1px;
    background: rgba(226, 232, 240, 0.85);
    margin: 1.25rem 0;
  }

  /* Mobile Accordion Toggle Bar - Hidden on Desktop */
  .yt-desc-toggle-bar {
    display: none;
  }

  .yt-details-collapse {
    display: block;
    max-height: none;
    opacity: 1;
  }

  .yt-details-body {
    color: #334155;
  }

  .yt-project-desc {
    font-size: 0.96rem;
    color: #334155;
    line-height: 1.75;
    margin: 0;
    white-space: pre-line;
  }

  /* 6. Right Playlist Sidebar (Seperempat Layar YouTube Style) */
  .yt-playlist-sidebar {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .yt-sidebar-card {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 5rem;
  }

  .yt-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .yt-header-title-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .yt-header-icon {
    color: #0f172a;
  }

  .yt-playlist-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .yt-playlist-count-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: #0f172a;
    background: rgba(15, 23, 42, 0.06);
    border: 1px solid rgba(15, 23, 42, 0.1);
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .yt-sidebar-subtitle {
    font-size: 0.76rem;
    color: #64748b;
    margin: 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.75);
    padding-bottom: 0.75rem;
  }

  /* Scrollable Video List */
  .yt-playlist-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-height: calc(100vh - 240px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(15, 23, 42, 0.15) transparent;
  }

  @media (max-width: 1024px) {
    .yt-playlist-list {
      max-height: none;
    }
    .yt-sidebar-card {
      position: static;
    }
  }

  .yt-playlist-list::-webkit-scrollbar {
    width: 4px;
  }

  .yt-playlist-list::-webkit-scrollbar-thumb {
    background: rgba(15, 23, 42, 0.15);
    border-radius: 4px;
  }

  /* Individual YouTube-Style Video Card */
  .yt-video-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(226, 232, 240, 0.85);
    cursor: pointer;
    text-align: left;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    width: 100%;
    box-sizing: border-box;
  }

  .yt-video-row:hover {
    background: #ffffff;
    border-color: #0f172a;
    transform: translateY(-1.5px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
  }

  /* Active Row (Now Playing) */
  .yt-video-row.active {
    background: #ffffff;
    border-color: #0f172a;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08);
  }

  /* 16:9 Mini Thumbnail on the Left (Landscape) */
  .yt-row-thumb-box {
    position: relative;
    width: 120px;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: #0f172a;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
  }

  @media (max-width: 480px) {
    .yt-row-thumb-box {
      width: 100px;
    }
  }

  .yt-row-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .yt-video-row:hover .yt-row-thumb-img {
    transform: scale(1.05);
  }

  /* Mini Index Badge on Thumbnail */
  .yt-row-index-pill {
    position: absolute;
    bottom: 0.35rem;
    right: 0.35rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    line-height: 1.2;
    z-index: 2;
  }

  /* Play Hover Overlay */
  .yt-row-play-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .yt-video-row:hover .yt-row-play-overlay {
    opacity: 1;
  }

  .yt-row-play-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  /* Row Meta on the Right */
  .yt-row-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
  }

  .yt-row-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .yt-video-row.active .yt-row-title {
    font-weight: 700;
    color: #0f172a;
  }

  /* Status Chip */
  .yt-row-status-box {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: #64748b;
  }

  .yt-video-row.active .yt-row-status-box {
    color: #047857;
    font-weight: 600;
  }

  .yt-row-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #cbd5e1;
    display: inline-block;
  }

  .yt-video-row.active .yt-row-dot {
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  /* ========================================================
     VERTICAL / SHORTS (9:16) SPECIALIZED PLAYLIST LAYOUT
     ======================================================== */
  .yt-layout-grid.is-vertical-video .yt-playlist-sidebar {
    width: 100%;
  }

  .yt-layout-grid.is-vertical-video .yt-sidebar-card {
    position: static;
    top: auto;
    padding: 1.25rem 1.35rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(226, 232, 240, 0.85);
    box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.05);
    gap: 0.75rem;
  }

  .yt-layout-grid.is-vertical-video .yt-playlist-list {
    max-height: 380px;
    gap: 0.55rem;
    padding-right: 0.35rem;
  }

  /* Shorts 9:16 Portrait Thumbnail */
  .yt-layout-grid.is-vertical-video .yt-row-thumb-box,
  .yt-video-row.is-vertical-item .yt-row-thumb-box {
    width: 52px;
    aspect-ratio: 9 / 16;
    border-radius: 8px;
    flex-shrink: 0;
    background: #0f172a;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
  }

  @media (max-width: 480px) {
    .yt-layout-grid.is-vertical-video .yt-row-thumb-box,
    .yt-video-row.is-vertical-item .yt-row-thumb-box {
      width: 48px;
    }
  }

  .yt-layout-grid.is-vertical-video .yt-row-index-pill,
  .yt-video-row.is-vertical-item .yt-row-index-pill {
    bottom: 0.25rem;
    right: 0.25rem;
    font-size: 0.58rem;
    padding: 0.06rem 0.25rem;
    border-radius: 3px;
  }

  .yt-layout-grid.is-vertical-video .yt-row-play-icon,
  .yt-video-row.is-vertical-item .yt-row-play-icon {
    width: 22px;
    height: 22px;
  }

  .yt-layout-grid.is-vertical-video .yt-row-play-icon svg,
  .yt-video-row.is-vertical-item .yt-row-play-icon svg {
    width: 11px;
    height: 11px;
  }

  .yt-layout-grid.is-vertical-video .yt-video-row,
  .yt-video-row.is-vertical-item {
    padding: 0.5rem 0.75rem;
    gap: 0.85rem;
  }

  .yt-layout-grid.is-vertical-video .yt-row-info,
  .yt-video-row.is-vertical-item .yt-row-info {
    gap: 0.35rem;
  }

  .yt-layout-grid.is-vertical-video .yt-row-title,
  .yt-video-row.is-vertical-item .yt-row-title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    color: #0f172a;
  }
</style>

<script>
  // Controller for YouTube-Style Studio Video Modal
  const modal = document.getElementById('videoModal');
  const closeBtn = document.getElementById('modalCloseBtn');
  const closeLabel = document.getElementById('modalCloseLabel');
  const iframe = document.getElementById('modalVideoIframe') as HTMLIFrameElement | null;
  const clientBreadcrumb = document.getElementById('modalClientBreadcrumb');
  const titleEl = document.getElementById('modalProjectTitle');
  const clientEl = document.getElementById('modalClientTag');
  const descEl = document.getElementById('modalProjectDesc');
  const toolsEl = document.getElementById('modalToolsTags');
  const layoutGrid = document.getElementById('ytLayoutGrid');
  const playlistWrapper = document.getElementById('modalPlaylistWrapper');
  const playlistTitle = document.getElementById('modalPlaylistTitle');
  const playlistSubtitle = document.getElementById('modalPlaylistSubtitle');
  const playlistCount = document.getElementById('modalPlaylistCount');
  const playlistTrack = document.getElementById('modalPlaylistTrack');
  const scrollCanvas = document.getElementById('ytModalScroll');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  const descToggleBtn = document.getElementById('modalDescToggleBtn');
  const descTogglePill = document.getElementById('modalDescTogglePill');
  const descCollapse = document.getElementById('modalDescCollapse');
  const detailsBox = document.getElementById('modalDetailsBox');

  function setDescState(isExpanded: boolean) {
    if (!descCollapse || !descToggleBtn) return;
    const isIdLocale = window.location.pathname.startsWith('/id');

    if (isExpanded) {
      descCollapse.classList.remove('is-collapsed');
      descCollapse.classList.add('is-expanded');
      descToggleBtn.setAttribute('aria-expanded', 'true');
      if (descTogglePill) descTogglePill.textContent = isIdLocale ? 'Sembunyikan' : 'Hide';
      if (detailsBox) detailsBox.classList.remove('is-desc-collapsed');
    } else {
      descCollapse.classList.remove('is-expanded');
      descCollapse.classList.add('is-collapsed');
      descToggleBtn.setAttribute('aria-expanded', 'false');
      if (descTogglePill) descTogglePill.textContent = isIdLocale ? 'Buka' : 'Show';
      if (detailsBox) detailsBox.classList.add('is-desc-collapsed');
    }
  }

  descToggleBtn?.addEventListener('click', () => {
    const isCurrentlyExpanded = descToggleBtn.getAttribute('aria-expanded') === 'true';
    setDescState(!isCurrentlyExpanded);
  });

  function extractYouTubeId(urlOrId: string): string {
    if (!urlOrId) return '';
    const trimmed = urlOrId.trim();
    if (/^[\w-]{11}$/.test(trimmed)) return trimmed;
    const match = trimmed.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|shorts\/|live\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
    return match ? match[1] : trimmed;
  }

  function openModal(card: HTMLElement) {
    const rawVideoId = card.getAttribute('data-video-id') || '';
    const videoId = extractYouTubeId(rawVideoId);
    const title = card.getAttribute('data-title') || '';
    const client = card.getAttribute('data-client') || '';
    const desc = card.getAttribute('data-desc') || '';
    const toolsJson = card.getAttribute('data-tools') || '[]';
    const videosJson = card.getAttribute('data-videos') || '[]';

    let videos: Array<{ title: string; youtubeId: string }> = [];
    try {
      videos = JSON.parse(videosJson);
    } catch {
      videos = [];
    }

    if (clientBreadcrumb) clientBreadcrumb.textContent = client || 'Project';
    if (titleEl) titleEl.textContent = title;
    if (clientEl) clientEl.textContent = client;
    if (descEl) descEl.textContent = desc;

    // Reset description to drop-up (expanded) position on mobile when opened
    setDescState(true);

    // Tools Badges
    if (toolsEl) {
      toolsEl.innerHTML = '';
      try {
        const tools: string[] = JSON.parse(toolsJson);
        tools.forEach((tool) => {
          const badge = document.createElement('span');
          badge.className = 'yt-tool-chip font-mono';
          badge.textContent = tool;
          toolsEl.appendChild(badge);
        });
      } catch {}
    }

    // Localization
    const isIdLocale = window.location.pathname.startsWith('/id');
    const playingLabel = isIdLocale ? 'Sedang Diputar' : 'Now Playing';
    const clickToPlayLabel = isIdLocale ? 'Klik untuk putar' : 'Click to play';
    const playlistHeading = isIdLocale ? 'Koleksi Video' : 'Video Collection';
    const playlistSub = isIdLocale ? 'Pilih video di bawah untuk memutar' : 'Select a video below to play';
    const videoSuffix = isIdLocale ? 'Video' : 'Videos';
    const closeText = isIdLocale ? 'Tutup (Esc)' : 'Close (Esc)';

    if (closeLabel) closeLabel.textContent = closeText;
    if (playlistTitle) playlistTitle.textContent = playlistHeading;
    if (playlistSubtitle) playlistSubtitle.textContent = playlistSub;

    const isVerticalAttr = card.getAttribute('data-is-vertical');
    let isVertical = isVerticalAttr === 'true';
    if (!isVertical) {
      isVertical = (videoId === 'J8ACXUcnFqc' || videoId === 'a0J5Vug7lrQ');
    }

    function setPlayerOrientation(vertical: boolean) {
      if (layoutGrid) {
        layoutGrid.classList.toggle('is-vertical-video', vertical);
      }
    }

    setPlayerOrientation(isVertical);

    // Multi-video playlist rendering (YouTube 2-column sidebar mode)
    if (videos && videos.length > 1 && playlistWrapper && playlistTrack && playlistCount && layoutGrid) {
      layoutGrid.classList.remove('is-single-video');
      playlistWrapper.style.display = 'flex';
      playlistCount.textContent = `${videos.length} ${videoSuffix}`;
      playlistTrack.innerHTML = '';

      videos.forEach((vid, index) => {
        const cleanVidId = extractYouTubeId(vid.youtubeId);
        const itemIsVertical = (vid as any).isVertical === true || isVertical;
        const itemBtn = document.createElement('button');
        itemBtn.type = 'button';
        itemBtn.className = `yt-video-row ${itemIsVertical ? 'is-vertical-item' : ''} ${index === 0 ? 'active' : ''}`;
        itemBtn.setAttribute('data-video-id', cleanVidId);

        const indexFormatted = `#${String(index + 1).padStart(2, '0')}`;
        const defaultThumb = `https://img.youtube.com/vi/${cleanVidId}/mqdefault.jpg`;
        const portraitThumb = `https://i.ytimg.com/vi/${cleanVidId}/oar2.jpg`;
        const thumbUrl = itemIsVertical ? portraitThumb : defaultThumb;

        itemBtn.innerHTML = `
          <div class="yt-row-thumb-box">
            <img 
              src="${thumbUrl}" 
              alt="${vid.title || 'Video'}" 
              class="yt-row-thumb-img" 
              loading="lazy" 
              onerror="if(!this.dataset.fallback){this.dataset.fallback='1';this.src='${defaultThumb}';}"
            />
            <div class="yt-row-play-overlay">
              <div class="yt-row-play-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <span class="yt-row-index-pill font-mono">${indexFormatted}</span>
          </div>
          <div class="yt-row-info">
            <span class="yt-row-title">${vid.title || `Video ${index + 1}`}</span>
            <div class="yt-row-status-box font-mono">
              <span class="yt-row-dot"></span>
              <span class="yt-status-text">${index === 0 ? playingLabel : clickToPlayLabel}</span>
            </div>
          </div>
        `;

        itemBtn.addEventListener('click', () => {
          setPlayerOrientation(itemIsVertical);
          if (iframe && cleanVidId) {
            iframe.src = `https://www.youtube.com/embed/${cleanVidId}?autoplay=1&rel=0`;
          }
          playlistTrack.querySelectorAll('.yt-video-row').forEach((el) => {
            el.classList.remove('active');
            const statusEl = el.querySelector('.yt-status-text');
            if (statusEl) statusEl.textContent = clickToPlayLabel;
          });
          itemBtn.classList.add('active');
          const activeStatus = itemBtn.querySelector('.yt-status-text');
          if (activeStatus) activeStatus.textContent = playingLabel;

          // Smoothly scroll back up to the player frame
          if (scrollCanvas) {
            scrollCanvas.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });

        playlistTrack.appendChild(itemBtn);
      });

      // Play first video automatically
      const firstVideoId = extractYouTubeId(videos[0]?.youtubeId || videoId);
      if (iframe && firstVideoId) {
        iframe.src = `https://www.youtube.com/embed/${firstVideoId}?autoplay=1&rel=0`;
      }
    } else {
      // Single video mode: center player and hide right sidebar
      if (layoutGrid) layoutGrid.classList.add('is-single-video');
      if (playlistWrapper) playlistWrapper.style.display = 'none';
      if (iframe && videoId) {
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      }
    }

    if (modal) {
      modal.style.display = 'flex';
      // Double rAF ensures the browser paints initial transform & opacity before starting transition
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          modal.classList.add('open');
        });
      });
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (scrollCanvas) scrollCanvas.scrollTop = 0;
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!modal.classList.contains('open')) {
          modal.style.display = 'none';
          if (layoutGrid) {
            layoutGrid.classList.remove('is-vertical-video');
          }
          if (iframe) {
            iframe.src = '';
          }
          if (playlistTrack) {
            playlistTrack.innerHTML = '';
          }
        }
      }, 480);
    }
  }

  // Open modal on card click
  projectCards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  // Close modal on close button click
  closeBtn?.addEventListener('click', closeModal);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
    }
  });
</script>
