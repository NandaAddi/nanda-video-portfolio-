---
import type { VideoModalTranslations } from '../data/locales/types';

interface Props {
  modal?: VideoModalTranslations;
}

const {
  modal = {
    closeAria: 'Close video player',
    watchOnYoutube: 'Watch on YouTube',
  },
} = Astro.props;
---

<div id="videoModal" class="video-modal-backdrop" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="video-modal-container">
    
    <!-- Close Button -->
    <button id="modalCloseBtn" class="modal-close-btn" aria-label={modal.closeAria}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Content Box -->
    <div class="video-modal-content">
      
      <!-- Video Player Frame (16:9 Responsive) -->
      <div class="video-player-wrapper">
        <iframe 
          id="modalVideoIframe"
          src="" 
          title="Video Player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>

      <!-- Playlist Strip for Multiple Videos -->
      <div id="modalPlaylistWrapper" class="modal-playlist-wrapper" style="display: none;">
        <div class="playlist-header">
          <div class="playlist-label-group">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" class="playlist-icon">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <span id="modalPlaylistTitle" class="playlist-title">Video Playlist</span>
          </div>
          <span id="modalPlaylistCount" class="playlist-count">3 Videos</span>
        </div>
        <div id="modalPlaylistTrack" class="playlist-track">
          <!-- Playlist items injected dynamically -->
        </div>
      </div>

      <!-- Video Details Panel -->
      <div class="video-details-panel">
        <div class="details-header">
          <div>
            <span id="modalClientTag" class="modal-client-tag">Klien / Seri</span>
            <h3 id="modalProjectTitle" class="modal-project-title">Judul Video</h3>
          </div>
          <div id="modalToolsTags" class="modal-tools-tags">
            <!-- Software badges injected dynamically -->
          </div>
        </div>

        <div class="details-body">
          <p id="modalProjectDesc" class="modal-project-desc">Deskripsi proyek video...</p>
        </div>
      </div>

    </div>

  </div>
</div>

<style is:global>
  .video-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(15, 23, 42, 0.42);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-modal-backdrop.open {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  .video-modal-container {
    position: relative;
    width: 100%;
    max-width: 900px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(24px) saturate(190%);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: var(--radius-2xl);
    box-shadow: 0 25px 60px -12px rgba(15, 23, 42, 0.22), inset 0 1px 1.5px rgba(255, 255, 255, 0.98);
    overflow: hidden;
    transform: scale(0.94) translateY(18px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
  }

  .video-modal-backdrop.open .video-modal-container {
    transform: scale(1) translateY(0);
  }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 20;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    color: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
    transition: all var(--transition-fast);
  }

  .modal-close-btn:hover {
    background: #ffffff;
    transform: rotate(90deg) scale(1.05);
  }

  .video-modal-content {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  /* 16:9 Video Frame */
  .video-player-wrapper {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    background: #000000;
  }

  .video-player-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Playlist Strip */
  .modal-playlist-wrapper {
    background: #f8fafc;
    border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    padding: 0.85rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  @media (max-width: 640px) {
    .modal-playlist-wrapper {
      padding: 0.75rem 1rem;
    }
  }

  .playlist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .playlist-label-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .playlist-icon {
    color: var(--accent-primary, #0f172a);
  }

  .playlist-title {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
  }

  .playlist-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    background: #e2e8f0;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-xs, 4px);
  }

  .playlist-track {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    scrollbar-width: thin;
  }

  .playlist-track::-webkit-scrollbar {
    height: 4px;
  }

  .playlist-track::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }

  :global(.playlist-item) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
    padding: 0.55rem 0.85rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-fast, 0.2s ease);
    max-width: 280px;
    user-select: none;
  }

  :global(.playlist-item:hover) {
    background: #f1f5f9;
    border-color: #cbd5e1;
    transform: translateY(-1px);
  }

  :global(.playlist-item.active) {
    background: #0f172a;
    border-color: #0f172a;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
  }

  :global(.playlist-item-index) {
    font-size: 0.72rem;
    font-weight: 700;
    font-family: monospace;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
    flex-shrink: 0;
  }

  :global(.playlist-item.active .playlist-item-index) {
    background: rgba(255, 255, 255, 0.15);
    color: #38bdf8;
  }

  :global(.playlist-item-info) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.playlist-item-title) {
    font-size: 0.82rem;
    font-weight: 500;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.playlist-item.active .playlist-item-title) {
    color: #ffffff;
    font-weight: 600;
  }

  :global(.playlist-item-status) {
    font-size: 0.68rem;
    color: #64748b;
  }

  :global(.playlist-item.active .playlist-item-status) {
    color: #38bdf8;
    font-weight: 500;
  }

  /* Details Panel */
  .video-details-panel {
    padding: 1.75rem 2rem;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .video-details-panel {
      padding: 1.25rem;
    }
  }

  .details-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    padding-bottom: 1rem;
  }

  .modal-client-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .modal-project-title {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--text-main);
    line-height: 1.3;
  }

  .modal-tools-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.modal-tool-badge) {
    font-size: 0.75rem;
    font-weight: 500;
    color: #334155;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .modal-project-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
</style>

<script>
  // Video Modal Logic
  const modal = document.getElementById('videoModal');
  const closeBtn = document.getElementById('modalCloseBtn');
  const iframe = document.getElementById('modalVideoIframe') as HTMLIFrameElement | null;
  const titleEl = document.getElementById('modalProjectTitle');
  const clientEl = document.getElementById('modalClientTag');
  const descEl = document.getElementById('modalProjectDesc');
  const toolsEl = document.getElementById('modalToolsTags');
  const playlistWrapper = document.getElementById('modalPlaylistWrapper');
  const playlistTitle = document.getElementById('modalPlaylistTitle');
  const playlistCount = document.getElementById('modalPlaylistCount');
  const playlistTrack = document.getElementById('modalPlaylistTrack');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  function openModal(card: HTMLElement) {
    const videoId = card.getAttribute('data-video-id') || '';
    const title = card.getAttribute('data-title') || '';
    const client = card.getAttribute('data-client') || '';
    const desc = card.getAttribute('data-desc') || '';
    const toolsJson = card.getAttribute('data-tools') || '[]';
    const videosJson = card.getAttribute('data-videos') || '[]';

    let videos: Array<{ title: string; youtubeId: string }> = [];
    try {
      videos = JSON.parse(videosJson);
    } catch (e) {
      videos = [];
    }

    if (titleEl) titleEl.textContent = title;
    if (clientEl) clientEl.textContent = client;
    if (descEl) descEl.textContent = desc;

    if (toolsEl) {
      toolsEl.innerHTML = '';
      try {
        const tools: string[] = JSON.parse(toolsJson);
        tools.forEach((tool) => {
          const badge = document.createElement('span');
          badge.className = 'modal-tool-badge';
          badge.textContent = tool;
          toolsEl.appendChild(badge);
        });
      } catch (e) {
        // Fallback
      }
    }

    const isIdLocale = window.location.pathname.startsWith('/id');
    const playingLabel = isIdLocale ? 'Sedang Diputar' : 'Now Playing';
    const clickToPlayLabel = isIdLocale ? 'Klik untuk memutar' : 'Click to play';
    const playlistHeading = isIdLocale ? 'Daftar Video' : 'Video Playlist';
    const videoSuffix = isIdLocale ? 'Video' : 'Videos';

    if (playlistTitle) playlistTitle.textContent = playlistHeading;

    if (videos && videos.length > 1 && playlistWrapper && playlistTrack && playlistCount) {
      playlistWrapper.style.display = 'flex';
      playlistCount.textContent = `${videos.length} ${videoSuffix}`;
      playlistTrack.innerHTML = '';

      videos.forEach((vid, index) => {
        const itemBtn = document.createElement('button');
        itemBtn.type = 'button';
        itemBtn.className = `playlist-item ${index === 0 ? 'active' : ''}`;
        itemBtn.setAttribute('data-video-id', vid.youtubeId);

        const indexFormatted = String(index + 1).padStart(2, '0');
        itemBtn.innerHTML = `
          <div class="playlist-item-index">${indexFormatted}</div>
          <div class="playlist-item-info">
            <span class="playlist-item-title">${vid.title || `Video ${index + 1}`}</span>
            <span class="playlist-item-status">${index === 0 ? playingLabel : clickToPlayLabel}</span>
          </div>
        `;

        itemBtn.addEventListener('click', () => {
          if (iframe && vid.youtubeId) {
            iframe.src = `https://www.youtube.com/embed/${vid.youtubeId}?autoplay=1&rel=0`;
          }
          playlistTrack.querySelectorAll('.playlist-item').forEach((el) => {
            el.classList.remove('active');
            const statusEl = el.querySelector('.playlist-item-status');
            if (statusEl) statusEl.textContent = clickToPlayLabel;
          });
          itemBtn.classList.add('active');
          const activeStatus = itemBtn.querySelector('.playlist-item-status');
          if (activeStatus) activeStatus.textContent = playingLabel;
        });

        playlistTrack.appendChild(itemBtn);
      });

      const firstVideoId = videos[0]?.youtubeId || videoId;
      if (iframe && firstVideoId) {
        iframe.src = `https://www.youtube.com/embed/${firstVideoId}?autoplay=1&rel=0`;
      }
    } else {
      if (playlistWrapper) playlistWrapper.style.display = 'none';
      if (iframe && videoId) {
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      }
    }

    if (modal) {
      modal.style.display = 'flex';
      requestAnimationFrame(() => {
        modal.classList.add('open');
      });
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!modal.classList.contains('open')) {
          modal.style.display = 'none';
        }
      }, 300);
    }
    if (iframe) {
      // Empty src immediately stops video playback and audio
      iframe.src = '';
    }
    if (playlistTrack) {
      playlistTrack.innerHTML = '';
    }
  }

  // Open modal on card click
  projectCards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  // Close modal on close button click
  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }

  // Close modal when clicking outside container
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  // Close modal on Escape key press
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.classList.contains('open')) {
      closeModal();
    }
  });
</script>
