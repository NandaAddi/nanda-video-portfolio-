---
import type { VideoModalTranslations } from '../data/locales/types';

interface Props {
  modal?: VideoModalTranslations;
}

const {
  modal = {
    closeAria: 'Close video player',
    watchOnYoutube: 'Watch on YouTube',
  },
} = Astro.props;
---

<div id="videoModal" class="cinema-overlay" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true">
  
  <!-- Ambient Cinematic Background Glow -->
  <div class="cinema-ambient-bg"></div>

  <!-- Sticky Cinema Top Navigation Bar -->
  <header class="cinema-navbar">
    <div class="cinema-nav-left">
      <span class="cinema-badge-live font-mono">CINEMA REEL</span>
      <span class="cinema-nav-divider">/</span>
      <span id="modalClientBreadcrumb" class="cinema-breadcrumb font-mono">Project Showcase</span>
    </div>

    <button id="modalCloseBtn" class="cinema-close-pill" aria-label={modal.closeAria} type="button">
      <span class="cinema-close-text font-mono" id="modalCloseLabel">Tutup (Esc)</span>
      <div class="cinema-close-icon">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </div>
    </button>
  </header>

  <!-- Full-Screen Scrollable Canvas -->
  <div class="cinema-scroll-canvas" id="cinemaScrollCanvas">
    <div class="cinema-container">

      <!-- Main Video Theater Frame (16:9 Cinematic Aspect) -->
      <div class="cinema-theater-frame">
        <div class="cinema-player-aspect">
          <iframe 
            id="modalVideoIframe"
            src="" 
            title="Video Player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <!-- Multiple Videos Cinema Strip Section -->
      <section id="modalPlaylistWrapper" class="cinema-playlist-section" style="display: none;">
        <div class="cinema-playlist-header">
          <div class="playlist-heading-group">
            <div class="playlist-badge-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <div>
              <h3 id="modalPlaylistTitle" class="cinema-playlist-title font-mono">Koleksi Video Proyek</h3>
              <p id="modalPlaylistSubtitle" class="cinema-playlist-subtitle">Pilih thumbnail video di bawah untuk memutar</p>
            </div>
          </div>
          <span id="modalPlaylistCount" class="cinema-playlist-pill font-mono">3 Videos</span>
        </div>

        <!-- Cinema Cards Track -->
        <div id="modalPlaylistTrack" class="cinema-cards-track">
          <!-- Dynamic 16:9 Thumbnail Cards injected dynamically by JS -->
        </div>
      </section>

      <!-- Video Details & Narrative Panel -->
      <article class="cinema-details-card">
        <div class="cinema-details-top">
          <div class="cinema-title-wrap">
            <span id="modalClientTag" class="cinema-client-meta font-mono">KLIEN / KATEGORI</span>
            <h1 id="modalProjectTitle" class="cinema-project-heading">Judul Karya Portofolio</h1>
          </div>
          <div id="modalToolsTags" class="cinema-tools-list">
            <!-- Software badges injected dynamically -->
          </div>
        </div>

        <div class="cinema-details-desc-box">
          <p id="modalProjectDesc" class="cinema-project-paragraph">Deskripsi proyek video...</p>
        </div>
      </article>

    </div>
  </div>
</div>

<style is:global>
  /* 1. Full-Screen Cinema Overlay Container */
  .cinema-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    width: 100vw;
    height: 100vh;
    background: #080c14;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .cinema-overlay.open {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  /* Ambient Glow Background */
  .cinema-ambient-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 20%, rgba(56, 189, 248, 0.08) 0%, rgba(8, 12, 20, 0) 70%),
                radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.05) 0%, rgba(8, 12, 20, 0) 60%);
    pointer-events: none;
    z-index: 1;
  }

  /* 2. Sticky Cinema Top Navigation Bar */
  .cinema-navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: rgba(8, 12, 20, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .cinema-navbar {
      padding: 0.85rem 1.25rem;
    }
  }

  .cinema-nav-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .cinema-badge-live {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .cinema-nav-divider {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.85rem;
  }

  .cinema-breadcrumb {
    font-size: 0.85rem;
    color: #94a3b8;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Close Pill Button */
  .cinema-close-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f8fafc;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-radius: 9999px;
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .cinema-close-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .cinema-close-text {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  @media (max-width: 480px) {
    .cinema-close-text {
      display: none;
    }
    .cinema-close-pill {
      padding: 0.45rem;
    }
  }

  .cinema-close-icon {
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .cinema-close-pill:hover .cinema-close-icon {
    transform: rotate(90deg);
    background: rgba(255, 255, 255, 0.25);
  }

  /* 3. Scrollable Canvas Area */
  .cinema-scroll-canvas {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
    z-index: 10;
    scroll-behavior: smooth;
    padding: 2rem 1.5rem 5rem 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .cinema-scroll-canvas::-webkit-scrollbar {
    width: 6px;
  }

  .cinema-scroll-canvas::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 6px;
  }

  .cinema-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  /* 4. Theater Player Frame (16:9 Aspect) */
  .cinema-theater-frame {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.95), 
                0 0 50px rgba(56, 189, 248, 0.12),
                inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .cinema-player-aspect {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 widescreen ratio */
    background: #000000;
  }

  .cinema-player-aspect iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* 5. Multiple Videos Cinema Strip Section */
  .cinema-playlist-section {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (max-width: 640px) {
    .cinema-playlist-section {
      padding: 1.25rem;
    }
  }

  .cinema-playlist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .playlist-heading-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .playlist-badge-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cinema-playlist-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .cinema-playlist-subtitle {
    font-size: 0.78rem;
    color: #94a3b8;
    margin: 0.15rem 0 0 0;
  }

  .cinema-playlist-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }

  /* Cinema Cards Track (Horizontal scrollable & responsive wrap) */
  .cinema-cards-track {
    display: flex;
    gap: 1.15rem;
    overflow-x: auto;
    padding-bottom: 0.65rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .cinema-cards-track::-webkit-scrollbar {
    height: 6px;
  }

  .cinema-cards-track::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
  }

  /* Individual 16:9 Cinema Card Item */
  :global(.cinema-card-item) {
    flex: 0 0 250px;
    max-width: 250px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.65rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    user-select: none;
  }

  @media (max-width: 640px) {
    :global(.cinema-card-item) {
      flex: 0 0 220px;
      max-width: 220px;
    }
  }

  :global(.cinema-card-item:hover) {
    background: rgba(30, 41, 59, 0.9);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6);
  }

  /* Active Card Highlight */
  :global(.cinema-card-item.active) {
    background: rgba(15, 23, 42, 0.95);
    border-color: #38bdf8;
    box-shadow: 0 0 28px rgba(56, 189, 248, 0.35), 0 10px 25px -5px rgba(0, 0, 0, 0.8);
  }

  /* 16:9 Thumbnail Cover Wrapper */
  :global(.cinema-card-thumb-wrap) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: #000000;
  }

  :global(.cinema-card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  :global(.cinema-card-item:hover .cinema-card-img) {
    transform: scale(1.06);
  }

  /* Play Hover Overlay */
  :global(.cinema-card-play-overlay) {
    position: absolute;
    inset: 0;
    background: rgba(8, 12, 20, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.cinema-card-item:hover .cinema-card-play-overlay) {
    opacity: 1;
  }

  :global(.cinema-play-badge) {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    transform: scale(0.85);
    transition: transform 0.2s ease;
  }

  :global(.cinema-card-item:hover .cinema-play-badge) {
    transform: scale(1);
  }

  /* Index Badge on thumbnail top-left */
  :global(.cinema-card-index) {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: #f8fafc;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
  }

  /* Live Pulsating Indicator Badge on Active Thumbnail */
  :global(.cinema-card-now-playing-badge) {
    position: absolute;
    bottom: 0.45rem;
    left: 0.45rem;
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(16, 185, 129, 0.92);
    backdrop-filter: blur(8px);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0.03em;
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.4);
  }

  :global(.cinema-card-item.active .cinema-card-now-playing-badge) {
    display: inline-flex;
  }

  :global(.cinema-live-pulse) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    animation: livePulse 1.4s infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.9); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
    100% { transform: scale(0.9); opacity: 1; }
  }

  /* Meta Info below thumbnail */
  :global(.cinema-card-meta) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  :global(.cinema-card-title) {
    font-size: 0.85rem;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.cinema-card-item.active .cinema-card-title) {
    color: #38bdf8;
  }

  :global(.cinema-card-action) {
    font-size: 0.72rem;
    color: #64748b;
    letter-spacing: 0.02em;
  }

  :global(.cinema-card-item.active .cinema-card-action) {
    color: #10b981;
    font-weight: 600;
  }

  /* 6. Video Details & Narrative Panel */
  .cinema-details-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (max-width: 640px) {
    .cinema-details-card {
      padding: 1.5rem 1.25rem;
    }
  }

  .cinema-details-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1.25rem;
  }

  .cinema-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 800px;
  }

  .cinema-client-meta {
    font-size: 0.78rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cinema-project-heading {
    font-size: 1.65rem;
    font-weight: 600;
    color: #f8fafc;
    line-height: 1.25;
    margin: 0;
  }

  @media (max-width: 640px) {
    .cinema-project-heading {
      font-size: 1.35rem;
    }
  }

  .cinema-tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  :global(.cinema-tool-tag) {
    font-size: 0.75rem;
    font-weight: 500;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
  }

  .cinema-details-desc-box {
    color: #94a3b8;
  }

  .cinema-project-paragraph {
    font-size: 1rem;
    color: #cbd5e1;
    line-height: 1.75;
    margin: 0;
    white-space: pre-line;
  }
</style>

<script>
  // Full-Screen Cinema Modal Controller
  const modal = document.getElementById('videoModal');
  const closeBtn = document.getElementById('modalCloseBtn');
  const closeLabel = document.getElementById('modalCloseLabel');
  const iframe = document.getElementById('modalVideoIframe') as HTMLIFrameElement | null;
  const clientBreadcrumb = document.getElementById('modalClientBreadcrumb');
  const titleEl = document.getElementById('modalProjectTitle');
  const clientEl = document.getElementById('modalClientTag');
  const descEl = document.getElementById('modalProjectDesc');
  const toolsEl = document.getElementById('modalToolsTags');
  const playlistWrapper = document.getElementById('modalPlaylistWrapper');
  const playlistTitle = document.getElementById('modalPlaylistTitle');
  const playlistSubtitle = document.getElementById('modalPlaylistSubtitle');
  const playlistCount = document.getElementById('modalPlaylistCount');
  const playlistTrack = document.getElementById('modalPlaylistTrack');
  const scrollCanvas = document.getElementById('cinemaScrollCanvas');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  function openModal(card: HTMLElement) {
    const videoId = card.getAttribute('data-video-id') || '';
    const title = card.getAttribute('data-title') || '';
    const client = card.getAttribute('data-client') || '';
    const desc = card.getAttribute('data-desc') || '';
    const toolsJson = card.getAttribute('data-tools') || '[]';
    const videosJson = card.getAttribute('data-videos') || '[]';

    let videos: Array<{ title: string; youtubeId: string }> = [];
    try {
      videos = JSON.parse(videosJson);
    } catch {
      videos = [];
    }

    if (clientBreadcrumb) clientBreadcrumb.textContent = client || 'Project';
    if (titleEl) titleEl.textContent = title;
    if (clientEl) clientEl.textContent = client;
    if (descEl) descEl.textContent = desc;

    // Tools Badges
    if (toolsEl) {
      toolsEl.innerHTML = '';
      try {
        const tools: string[] = JSON.parse(toolsJson);
        tools.forEach((tool) => {
          const badge = document.createElement('span');
          badge.className = 'cinema-tool-tag font-mono';
          badge.textContent = tool;
          toolsEl.appendChild(badge);
        });
      } catch {}
    }

    // Localization
    const isIdLocale = window.location.pathname.startsWith('/id');
    const playingLabel = isIdLocale ? 'Sedang Diputar' : 'Now Playing';
    const clickToPlayLabel = isIdLocale ? 'Klik untuk memutar' : 'Click to play';
    const playlistHeading = isIdLocale ? 'Koleksi Video Proyek' : 'Project Video Collection';
    const playlistSub = isIdLocale ? 'Pilih thumbnail video di bawah untuk memutar' : 'Select a video thumbnail below to play';
    const videoSuffix = isIdLocale ? 'Video' : 'Videos';
    const closeText = isIdLocale ? 'Tutup (Esc)' : 'Close (Esc)';

    if (closeLabel) closeLabel.textContent = closeText;
    if (playlistTitle) playlistTitle.textContent = playlistHeading;
    if (playlistSubtitle) playlistSubtitle.textContent = playlistSub;

    // Multi-video playlist rendering
    if (videos && videos.length > 1 && playlistWrapper && playlistTrack && playlistCount) {
      playlistWrapper.style.display = 'flex';
      playlistCount.textContent = `${videos.length} ${videoSuffix}`;
      playlistTrack.innerHTML = '';

      videos.forEach((vid, index) => {
        const itemBtn = document.createElement('button');
        itemBtn.type = 'button';
        itemBtn.className = `cinema-card-item ${index === 0 ? 'active' : ''}`;
        itemBtn.setAttribute('data-video-id', vid.youtubeId);

        const indexFormatted = `#${String(index + 1).padStart(2, '0')}`;
        const thumbUrl = `https://img.youtube.com/vi/${vid.youtubeId}/mqdefault.jpg`;

        itemBtn.innerHTML = `
          <div class="cinema-card-thumb-wrap">
            <img src="${thumbUrl}" alt="${vid.title || 'Video'}" class="cinema-card-img" loading="lazy" />
            <div class="cinema-card-play-overlay">
              <div class="cinema-play-badge">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <span class="cinema-card-index font-mono">${indexFormatted}</span>
            <span class="cinema-card-now-playing-badge font-mono">
              <span class="cinema-live-pulse"></span> ${playingLabel}
            </span>
          </div>
          <div class="cinema-card-meta">
            <span class="cinema-card-title">${vid.title || `Video ${index + 1}`}</span>
            <span class="cinema-card-action font-mono">${index === 0 ? playingLabel : clickToPlayLabel}</span>
          </div>
        `;

        itemBtn.addEventListener('click', () => {
          if (iframe && vid.youtubeId) {
            iframe.src = `https://www.youtube.com/embed/${vid.youtubeId}?autoplay=1&rel=0`;
          }
          playlistTrack.querySelectorAll('.cinema-card-item').forEach((el) => {
            el.classList.remove('active');
            const actionEl = el.querySelector('.cinema-card-action');
            if (actionEl) actionEl.textContent = clickToPlayLabel;
          });
          itemBtn.classList.add('active');
          const activeAction = itemBtn.querySelector('.cinema-card-action');
          if (activeAction) activeAction.textContent = playingLabel;

          // Smoothly scroll back up to the player frame
          if (scrollCanvas) {
            scrollCanvas.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });

        playlistTrack.appendChild(itemBtn);
      });

      // Play first video automatically
      const firstVideoId = videos[0]?.youtubeId || videoId;
      if (iframe && firstVideoId) {
        iframe.src = `https://www.youtube.com/embed/${firstVideoId}?autoplay=1&rel=0`;
      }
    } else {
      // Single video mode
      if (playlistWrapper) playlistWrapper.style.display = 'none';
      if (iframe && videoId) {
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      }
    }

    if (modal) {
      modal.style.display = 'flex';
      requestAnimationFrame(() => {
        modal.classList.add('open');
      });
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (scrollCanvas) scrollCanvas.scrollTop = 0;
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!modal.classList.contains('open')) {
          modal.style.display = 'none';
        }
      }, 350);
    }
    if (iframe) {
      // Empty src immediately halts video playback & audio
      iframe.src = '';
    }
    if (playlistTrack) {
      playlistTrack.innerHTML = '';
    }
  }

  // Open modal on card click
  projectCards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  // Close modal on close button click
  closeBtn?.addEventListener('click', closeModal);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
    }
  });
</script>
