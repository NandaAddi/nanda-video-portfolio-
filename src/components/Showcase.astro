---
import { portfolioData } from '../data/portfolio';
import type { ShowcaseTranslations, ProjectItemTranslation } from '../data/locales/types';

interface Props {
  showcase?: ShowcaseTranslations;
  projects?: ProjectItemTranslation[];
}

const {
  showcase = {
    tag: 'Portfolio Gallery',
    title: 'Selected Video & Visual Work',
    description: 'A curated collection of commercial videography, narrative video editing, and motion graphics crafted with meticulous cinematic pacing.',
    categories: [
      { id: 'all', label: 'All Works' },
      { id: 'editing', label: 'Video Editing' },
      { id: 'commercial', label: 'Commercial Video' },
      { id: 'motion', label: 'Motion Graphics' },
    ],
  },
  projects = portfolioData.projects,
} = Astro.props;

const categories = showcase.categories;
---

<section id="showcase" class="showcase-section">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">{showcase.tag}</span>
      <h2 class="section-title">{showcase.title}</h2>
      <p class="section-description">
        {showcase.description}
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="filter-tabs-container">
      <div class="filter-tabs" role="tablist" aria-label="Filter kategori video">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid" id="projectsGrid">
      {projects.map((item, idx) => (
        <article 
          class="project-card" 
          data-category={item.category}
          data-video-id={item.youtubeId}
          data-videos={JSON.stringify(item.videos || [])}
          data-title={item.title}
          data-client={item.client}
          data-desc={item.fullDescription}
          data-tools={JSON.stringify(item.tools)}
          data-duration={item.duration}
          data-is-vertical={item.isVertical ? 'true' : 'false'}
        >
          <!-- Thumbnail Container -->
          <div class="project-thumb-wrapper">
            <img 
              src={item.thumbnail} 
              alt={item.title} 
              class="project-thumb" 
              width="1280"
              height="720"
              loading="lazy"
            />
            <div class="thumb-overlay">
              <div class="play-btn-circle" aria-label="Play video">
                <svg viewBox="0 0 24 24" fill="currentColor" class="play-icon">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>

            <!-- Duration Frosted Micro-Pill -->
            <span class="thumb-duration font-mono">{item.duration}</span>

            <!-- Multi-Video Glassmorphism Badge (No Icon) -->
            {item.videos && item.videos.length > 1 && (
              <span class="thumb-multi-badge font-mono" title={`${item.videos.length} Videos`}>
                {item.videos.length} {showcase.tag?.toLowerCase().includes('galeri') ? 'Video' : 'Videos'}
              </span>
            )}
          </div>

          <!-- Two-Tier Editorial Project Details -->
          <div class="project-info">
            <div class="project-meta font-mono">
              <span class="project-client">{item.client}</span>
              <span class="meta-separator">/</span>
              <span class="project-category">{item.categoryLabel}</span>
            </div>
            <h3 class="project-title">{item.title}</h3>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .showcase-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    position: relative;
  }

  /* Filter Tabs */
  .filter-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .filter-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    padding: 0.35rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.035), inset 0 1px 1px rgba(255, 255, 255, 0.95);
  }

  .filter-btn {
    padding: 0.6rem 1.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    user-select: none;
  }

  .filter-btn:hover {
    color: var(--text-main);
    background: #f1f5f9;
  }

  .filter-btn:active {
    transform: scale(0.95);
  }

  .filter-btn.active {
    background: var(--accent-primary);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(15, 23, 42, 0.08);
    transform: scale(1.02);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Pure Minimalist Studio Project Card (Zero Stroke / Zero Outline) */
  .project-card {
    background: transparent;
    border: none;
    outline: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:focus,
  .project-card:focus-visible {
    outline: none;
  }

  .project-card:hover {
    background: transparent;
    transform: translateY(-4px);
    box-shadow: none;
  }

  .project-card.hidden {
    display: none !important;
  }

  .project-card.is-filtering-out {
    opacity: 0 !important;
    filter: blur(8px) !important;
    transform: scale(0.96) translateY(6px) !important;
    transition: opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1), 
                filter 0.15s cubic-bezier(0.4, 0, 0.2, 1), 
                transform 0.15s cubic-bezier(0.4, 0, 0.2, 1) !important;
    transition-delay: 0s !important;
    pointer-events: none;
    will-change: opacity, filter, transform;
  }

  .project-card.is-filtering-in {
    opacity: 0;
    filter: blur(10px);
    animation: cinematicFocusIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--filter-stagger, 0ms);
    will-change: opacity, filter, transform;
  }

  @keyframes cinematicFocusIn {
    0% {
      opacity: 0;
      filter: blur(10px);
      transform: scale(0.96) translateY(12px);
    }
    60% {
      opacity: 0.85;
      filter: blur(3px);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card.is-filtering-out,
    .project-card.is-filtering-in {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
  }

  /* 16:9 Thumbnail Hero Wrapper (Zero Stroke / Zero Outline) */
  .project-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background-color: #0f172a;
    border: none;
    outline: none;
    box-shadow: 0 4px 16px -3px rgba(15, 23, 42, 0.05);
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-thumb-wrapper {
    box-shadow: 0 16px 36px -10px rgba(15, 23, 42, 0.12);
  }

  .project-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-thumb {
    transform: scale(1.035);
  }

  /* Subtle Dark Vignette & Play Hover Overlay */
  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .thumb-overlay {
    opacity: 1;
  }

  .play-btn-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--accent-primary, #0f172a);
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    outline: none;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.2);
    transform: scale(0.85);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .play-btn-circle {
    transform: scale(1);
  }

  .play-icon {
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }

  /* Duration Frosted Micro-Pill (No Outline / No Stroke) */
  .thumb-duration {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0.04em;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
  }

  /* Multi-Video Glassmorphism Badge (No Outline / No Stroke, White Text) */
  .thumb-multi-badge {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffffff;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: none;
    outline: none;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  /* Two-Tier Editorial Metadata (Clean, Refined & Non-Bold) */
  .project-info {
    padding: 0.75rem 0.15rem 0 0.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .meta-separator {
    color: var(--text-light);
    font-size: 0.65rem;
  }

  .project-category {
    color: var(--text-light);
    font-weight: 400;
  }

  .project-title {
    font-size: 0.92rem;
    font-weight: 450;
    color: var(--text-main);
    line-height: 1.4;
    letter-spacing: -0.01em;
    transition: color var(--transition-fast);
  }

  .project-card:hover .project-title {
    color: var(--accent-blue, #0284c7);
  }
</style>

<script>
  // Filter Tabs Logic - Two-Phase Staggered Cascade
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  let activeFilter = 'all';
  let filterTimeout: ReturnType<typeof setTimeout> | null = null;

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetFilter = btn.getAttribute('data-filter') || 'all';
      if (targetFilter === activeFilter) return;

      activeFilter = targetFilter;

      // Update active tab UI
      filterBtns.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Clear pending transition timeout
      if (filterTimeout) {
        clearTimeout(filterTimeout);
        filterTimeout = null;
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Collect currently visible cards
      const visibleCards: HTMLElement[] = [];
      projectCards.forEach((card) => {
        if (!card.classList.contains('hidden')) {
          visibleCards.push(card);
        }
      });

      const applyNewFilter = () => {
        let matchIndex = 0;

        projectCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          const shouldShow = targetFilter === 'all' || cardCategory === targetFilter;

          // Clear previous transition states
          card.classList.remove('is-filtering-out');
          card.classList.remove('is-filtering-in');
          card.style.removeProperty('--filter-stagger');

          if (shouldShow) {
            card.classList.remove('hidden');
            card.classList.add('is-revealed');

            if (!prefersReducedMotion) {
              const staggerDelay = `${matchIndex * 40}ms`;
              card.style.setProperty('--filter-stagger', staggerDelay);

              // Force reflow to guarantee the animation runs from start
              void card.offsetWidth;
              card.classList.add('is-filtering-in');

              card.addEventListener(
                'animationend',
                () => {
                  card.classList.remove('is-filtering-in');
                  card.style.removeProperty('--filter-stagger');
                  card.style.removeProperty('filter');
                },
                { once: true }
              );
            }
            matchIndex++;
          } else {
            card.classList.add('hidden');
          }
        });
      };

      if (prefersReducedMotion || visibleCards.length === 0) {
        applyNewFilter();
      } else {
        // Phase 1: Smooth defocus blur fade-out of currently visible cards
        visibleCards.forEach((card) => {
          card.classList.remove('is-filtering-in');
          card.classList.add('is-filtering-out');
        });

        // Phase 2: Switch grid layout and cascade focus-in matching cards
        filterTimeout = setTimeout(() => {
          applyNewFilter();
          filterTimeout = null;
        }, 150);
      }
    });
  });
</script>
