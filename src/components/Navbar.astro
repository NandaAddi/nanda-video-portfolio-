---
import { portfolioData } from '../data/portfolio';
import type { Locale, NavTranslations } from '../data/locales/types';

interface Props {
  currentLocale?: Locale;
  currentPage?: 'home' | 'about';
  nav?: NavTranslations;
}

const { name, contact } = portfolioData;
const {
  currentLocale = 'en',
  currentPage = 'home',
  nav = {
    about: 'About',
    showcase: 'Selected Work',
    contact: 'Contact',
    ctaText: 'Get in Touch',
  },
} = Astro.props;

const homeHref = currentLocale === 'id' ? '/id' : '/';
const aboutHref = currentLocale === 'id' ? '/id/about' : '/about';
const showcaseHref = currentPage === 'home' 
  ? '#showcase' 
  : (currentLocale === 'id' ? '/id#showcase' : '/#showcase');
const contactHref = '#contact';

const enHref = currentPage === 'about' ? '/about' : '/';
const idHref = currentPage === 'about' ? '/id/about' : '/id';
---

<header class="navbar-header" id="navbar">
  <div class="container navbar-container">
    
    <!-- Brand / Logo -->
    <a href={homeHref} class="nav-brand">
      <span class="brand-name">{name}</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links-desktop">
      <a href={showcaseHref} class="nav-link">{nav.showcase}</a>
      <a href={aboutHref} class={`nav-link ${currentPage === 'about' ? 'active' : ''}`}>{nav.about}</a>
      <a href={contactHref} class="nav-link">{nav.contact}</a>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <!-- Language Switcher Pill Toggle -->
      <div class="lang-switcher" role="navigation" aria-label="Language selector">
        <a 
          href={enHref} 
          class={`lang-btn ${currentLocale === 'en' ? 'active' : ''}`}
          data-href-base={enHref}
          aria-label="Switch to English"
        >
          EN
        </a>
        <span class="lang-divider">/</span>
        <a 
          href={idHref} 
          class={`lang-btn ${currentLocale === 'id' ? 'active' : ''}`}
          data-href-base={idHref}
          aria-label="Ganti ke Bahasa Indonesia"
        >
          ID
        </a>
      </div>

      <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary nav-cta">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>{nav.ctaText}</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle navigation menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-nav-links">
      <a href={showcaseHref} class="mobile-link">{nav.showcase}</a>
      <a href={aboutHref} class={`mobile-link ${currentPage === 'about' ? 'active' : ''}`}>{nav.about}</a>
      <a href={contactHref} class="mobile-link">{nav.contact}</a>

      <!-- Mobile Language Switcher Row -->
      <div class="mobile-lang-row">
        <span class="mobile-lang-label">Language / Bahasa:</span>
        <div class="lang-switcher">
          <a href={enHref} class={`lang-btn ${currentLocale === 'en' ? 'active' : ''}`} data-href-base={enHref}>EN</a>
          <span class="lang-divider">/</span>
          <a href={idHref} class={`lang-btn ${currentLocale === 'id' ? 'active' : ''}`} data-href-base={idHref}>ID</a>
        </div>
      </div>

      <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mobile-cta">
        {nav.ctaText}
      </a>
    </nav>
  </div>
</header>

<style>
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 24px -2px rgba(15, 23, 42, 0.035), inset 0 -1px 0 rgba(226, 232, 240, 0.5);
    transition: all var(--transition-normal);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-main);
    letter-spacing: -0.025em;
  }

  /* Desktop Nav */
  .nav-links-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-main);
  }

  .nav-link.active {
    font-weight: 600;
  }

  /* Header Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Language Switcher Pill */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    user-select: none;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.95), 0 2px 6px rgba(15, 23, 42, 0.03);
  }

  .lang-btn {
    color: var(--text-dim);
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    transition: all var(--transition-fast);
    text-decoration: none;
    line-height: 1.1;
  }

  .lang-btn:hover {
    color: var(--text-main);
  }

  .lang-btn.active {
    background: #ffffff;
    color: var(--accent-primary);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
  }

  .lang-divider {
    color: #cbd5e1;
    font-size: 0.75rem;
  }

  .nav-cta {
    padding: 0.55rem 1.15rem;
    font-size: 0.85rem;
  }

  /* Mobile Hamburger */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 4px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.85);
  }

  .mobile-toggle .bar {
    width: 22px;
    height: 2px;
    background-color: var(--text-main);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mobile Dropdown */
  .mobile-menu {
    display: none;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(24px) saturate(190%);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.9);
    padding: 1.25rem 1.5rem;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-main);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }

  .mobile-link.active {
    font-weight: 600;
    color: var(--accent-primary, #0f172a);
  }

  .mobile-lang-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }

  .mobile-lang-label {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .mobile-cta {
    margin-top: 0.5rem;
    width: 100%;
  }

  @media (max-width: 820px) {
    .nav-links-desktop {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .nav-cta {
      display: none;
    }
  }
</style>

<script>
  // Mobile menu toggle logic
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
      });
    });
  }

  // Smart Anchor Preservation for Language Switcher
  const langLinks = document.querySelectorAll<HTMLAnchorElement>('.lang-btn');
  langLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const hash = window.location.hash;
      if (hash) {
        const baseHref = link.getAttribute('data-href-base') || link.getAttribute('href') || '/';
        link.href = baseHref === '/' ? `/${hash}` : `${baseHref}${hash}`;
      }
    });
  });
</script>
