---
import { portfolioData } from '../data/portfolio';

const { name, contact } = portfolioData;
---

<header class="navbar-header" id="navbar">
  <div class="container navbar-container">
    
    <!-- Brand / Logo -->
    <a href="#about" class="nav-brand">
      <span class="brand-name">{name}</span>
      <span class="status-badge">
        <span class="status-dot"></span>
        <span class="status-text">Available</span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links-desktop">
      <a href="#about" class="nav-link">Tentang</a>
      <a href="#stats" class="nav-link">Pencapaian</a>
      <a href="#showcase" class="nav-link">Karya Video</a>
      <a href="#contact" class="nav-link">Kontak</a>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary nav-cta">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>Hubungi Saya</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle navigation menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-nav-links">
      <a href="#about" class="mobile-link">Tentang</a>
      <a href="#stats" class="mobile-link">Pencapaian</a>
      <a href="#showcase" class="mobile-link">Karya Video</a>
      <a href="#contact" class="mobile-link">Kontak</a>
      <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mobile-cta">
        Konsultasi via WhatsApp
      </a>
    </nav>
  </div>
</header>

<style>
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(248, 251, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(2, 132, 199, 0.1);
    transition: all var(--transition-normal);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 600;
    color: #059669;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px #10b981;
    animation: pulseDot 2s infinite ease-in-out;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  /* Desktop Nav */
  .nav-links-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--accent-blue);
  }

  /* Header Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-cta {
    padding: 0.55rem 1.15rem;
    font-size: 0.85rem;
  }

  /* Mobile Hamburger */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 4px;
    border-radius: var(--radius-sm);
  }

  .mobile-toggle .bar {
    width: 22px;
    height: 2px;
    background-color: var(--text-main);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mobile Dropdown */
  .mobile-menu {
    display: none;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-light);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-main);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }

  .mobile-cta {
    margin-top: 0.5rem;
    width: 100%;
  }

  @media (max-width: 820px) {
    .nav-links-desktop {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .nav-cta {
      display: none;
    }
  }
</style>

<script>
  // Mobile menu toggle logic
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
      });
    });
  }
</script>
