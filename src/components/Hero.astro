---
import { portfolioData } from '../data/portfolio';
import type { HeroTranslations, Locale } from '../data/locales/types';

interface Props {
  hero?: HeroTranslations;
  locale?: Locale;
  variant?: 'compact' | 'full';
}

const {
  name,
  title: defaultTitle,
  profileCardImage,
  education: defaultEducation,
  softwares,
  contact
} = portfolioData;

const { hero, locale = 'en', variant = 'full' } = Astro.props;
const aboutHref = locale === 'id' ? '/id/about' : '/about';
const moreAboutMeText = hero?.moreAboutMe || (locale === 'id' ? 'Selengkapnya tentang saya →' : 'More about me →');
const cvButtonText = locale === 'id' ? 'CV Saya' : 'My CV';

const currentHero = hero || {
  tag: 'Creative Studio & Editorial Portfolio',
  greetingTitle: `Hi! I'm ${name}`,
  roles: ['Videographer & Video Editor'],
  bio: portfolioData.bio,
  primaryCta: 'Explore Selected Work',
  secondaryCta: 'Start a Project',
  stats: {
    experience: { value: '4+', label: 'Years Experience' },
    videos: { value: '500+', label: 'Videos Edited' },
    websites: { value: '9', label: 'Web Projects Built' },
  },
  education: {
    institution: defaultEducation.institution,
    major: defaultEducation.major,
    period: defaultEducation.period,
  },
  experiences: [
    { startDate: 'Aug 2024 -', endDate: 'Present', company: 'Indopride Roleplay', role: 'Video Editor', type: 'Fulltime' },
    { startDate: 'Apr 2025 -', endDate: 'Present', company: 'Kultus Visual', role: 'Motion Graphic Designer', type: 'Freelance' },
    { startDate: 'Mar 2024 -', endDate: 'Present', company: 'Aksara Picture', role: 'Photographer & Videographer', type: 'Freelance' },
    { startDate: 'Jun 2023 -', endDate: 'Jun 2024', company: 'Bina Project Construction', role: 'Social Media Specialist', type: 'Fulltime' }
  ]
};

const languages = locale === 'id' 
  ? [
      { language: 'Indonesia', proficiency: 'Penutur Asli', level: 5 },
      { language: 'Inggris', proficiency: 'Percakapan', level: 3 }
    ]
  : [
      { language: 'Indonesian', proficiency: 'Native', level: 5 },
      { language: 'English', proficiency: 'Conversational', level: 3 }
    ];

const educationTitle = locale === 'id' ? 'Pendidikan' : 'Education';
const languagesTitle = locale === 'id' ? 'Bahasa' : 'Languages';
const experienceTitle = currentHero.experienceHeading || (locale === 'id' ? 'Pengalaman' : 'Experience');
const softwaresTitle = locale === 'id' ? 'Perangkat Lunak' : 'Softwares';
const contactTitle = locale === 'id' ? 'Kontak' : 'Contact';
---

<section id="about" class={`hero-section ${variant === 'compact' ? 'hero-compact' : 'hero-full'}`}>
  <div class="container">
    <div class="hero-wrapper">
      
      <!-- TOP ROW: Profile Photo & Bio -->
      <div class="hero-top-row">
        <!-- Polaroid Card -->
        <div class="polaroid-container">
          <div class="polaroid-card">
            <img 
              src={profileCardImage} 
              alt={name} 
              class="polaroid-image" 
              width="300"
              height="300"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <!-- Greeting & Bio -->
        <div class="hero-bio-container">
          <div class="hero-heading-group">
            <h1 class="hero-title">
              <span class="greeting-hi">{locale === 'id' ? 'Halo!' : 'Hi!'}</span> 
              <span class="greeting-name">{locale === 'id' ? `Saya ${name}` : `I'm ${name}`}</span>
            </h1>
            <p class="hero-role">{locale === 'id' ? 'Videografer & Video Editor' : defaultTitle}</p>
          </div>

          <p class="hero-bio-text">
            {currentHero.bio.includes('LinkedIn.') 
              ? (
                <>
                  {currentHero.bio.slice(0, currentHero.bio.lastIndexOf('LinkedIn.'))}
                  <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="bio-link">LinkedIn.</a>
                </>
              ) 
              : currentHero.bio
            }
          </p>

          <div class="hero-actions">
            <a 
              href="/CV%20ATS%20ENG%20NANDA%20ADDI.pdf" 
              download="CV ATS ENG NANDA ADDI.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-download-cv"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="download-icon">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>{cvButtonText}</span>
            </a>

            {variant === 'compact' && (
              <a href={aboutHref} class="btn-more-about">
                <span>{moreAboutMeText}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
                  <path d="M5 12h14"></path>
                  <path d="M12 5l7 7-7 7"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- BOTTOM ROW: 3-Column Info Grid -->
      {variant === 'full' && (
      <div class="hero-bottom-grid">
        
        <!-- COLUMN 1: Education & Languages -->
        <div class="info-column">
          <!-- Education Section -->
          <div class="section-block">
            <h2 class="column-title">{educationTitle}</h2>
            <div class="education-card">
              <div class="um-logo-wrapper">
                <img
                  src={defaultEducation.logo || "/images/education.png"}
                  alt={currentHero.education.institution}
                  class="um-logo-img"
                  width="58"
                  height="58"
                  loading="lazy"
                />
              </div>
              <div class="education-details">
                <h3 class="institution-name">{currentHero.education.institution}</h3>
                <p class="education-major">{currentHero.education.major}</p>
                <p class="education-period">{currentHero.education.period}</p>
              </div>
            </div>
          </div>

          <!-- Languages Section -->
          <div class="section-block">
            <h2 class="column-title">{languagesTitle}</h2>
            <div class="languages-list">
              {languages.map((item) => (
                <div class="language-row">
                  <span class="language-name">{item.language}</span>
                  <span class="language-proficiency">{item.proficiency}</span>
                  <div class="dot-rating" aria-label={`${item.language} level ${item.level} of 5`}>
                    {[1, 2, 3, 4, 5].map((dot) => (
                      <span class={`dot ${dot <= item.level ? 'filled' : 'empty'}`} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- COLUMN 2: Experience -->
        <div class="info-column">
          <div class="section-block">
            <h2 class="column-title">{experienceTitle}</h2>
            <div class="experience-list">
              {currentHero.experiences.map((exp) => (
                <div class="experience-item">
                  <div class="exp-period">
                    <span class="period-line">{exp.startDate}</span>
                    <span class="period-line">{exp.endDate}</span>
                  </div>
                  <div class="exp-details">
                    <h3 class="exp-company">{exp.company}</h3>
                    <p class="exp-role-type">{exp.role} <span class="divider">|</span> {exp.type}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- COLUMN 3: Softwares & Contact -->
        <div class="info-column">
          <!-- Softwares Section -->
          <div class="section-block">
            <h2 class="column-title">{softwaresTitle}</h2>
            <div class="softwares-grid">
              {softwares.map((sw) => (
                <div class="software-card" title={sw.name}>
                  <div class="software-icon-wrapper">
                    <img src={sw.icon} alt={sw.name} class="software-icon" width="48" height="48" loading="lazy" />
                  </div>
                  <span class="software-label">{sw.name}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Contact Section -->
          <div class="section-block">
            <h2 class="column-title">{contactTitle}</h2>
            <div class="contact-compact-list">
              <div class="contact-compact-row">
                <span class="contact-label">Email</span>
                <span class="colon">:</span>
                <a href={`mailto:${contact.email}`} class="contact-value">{contact.email}</a>
              </div>
              <div class="contact-compact-row">
                <span class="contact-label">Phone</span>
                <span class="colon">:</span>
                <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-value">{contact.phone}</a>
              </div>
              <div class="contact-compact-row">
                <span class="contact-label">Instagram</span>
                <span class="colon">:</span>
                <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="contact-value">{contact.instagram}</a>
              </div>
            </div>
          </div>
        </div>

      </div>
      )}

    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 7.75rem;
    padding-bottom: 2.25rem;
    position: relative;
  }

  .hero-section.hero-compact {
    padding-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 6.5rem;
      padding-bottom: 1.5rem;
    }
  }

  .hero-wrapper {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }

  /* TOP ROW */
  .hero-top-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.75rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-top-row {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }
  }

  /* Hero Sequenced Entrance Animations */
  @keyframes heroSlideFade {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroPolaroidFade {
    from {
      opacity: 0;
      transform: translateY(28px) rotate(2deg) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0deg) scale(1);
    }
  }

  /* Polaroid Container & Card */
  .polaroid-container {
    display: flex;
    justify-content: center;
    animation: heroPolaroidFade 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .polaroid-card {
    position: relative;
    max-width: 280px;
    width: 100%;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    filter: drop-shadow(0 12px 24px rgba(15, 23, 42, 0.08)) drop-shadow(0 3px 6px rgba(15, 23, 42, 0.04));
  }

  .polaroid-card:hover {
    transform: translateY(-4px) rotate(-1deg);
    filter: drop-shadow(0 18px 28px rgba(15, 23, 42, 0.12)) drop-shadow(0 4px 8px rgba(15, 23, 42, 0.06));
  }

  .polaroid-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Bio & Greeting */
  .hero-bio-container {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    animation: heroSlideFade 0.95s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-heading-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-title {
    font-size: 2.45rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .greeting-hi {
    color: var(--text-main);
    font-weight: 500;
    font-size: 2.75rem;
  }

  .greeting-name {
    color: var(--text-main);
    font-weight: 400;
  }

  .hero-role {
    font-size: 1.1rem;
    font-weight: 500;
    font-style: italic;
    color: var(--text-dim);
    letter-spacing: -0.01em;
  }

  .hero-bio-text {
    font-size: 0.985rem;
    color: var(--text-muted);
    line-height: 1.72;
    text-align: justify;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .hero-bio-text {
      text-align: left;
    }
    .hero-title {
      justify-content: center;
    }
  }

  .bio-link {
    color: var(--text-main);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bio-link:hover {
    color: var(--text-main);
    opacity: 0.8;
  }

  /* Hero Actions (CV Download & More About Me CTA) */
  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn-download-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    background: #0f172a;
    border: 1px solid #0f172a;
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    transition: all var(--transition-fast, 0.2s ease);
    cursor: pointer;
  }

  .btn-download-cv:hover {
    background: #1e293b;
    border-color: #1e293b;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
    color: #ffffff;
  }

  .btn-download-cv:active {
    transform: scale(0.98);
  }

  .btn-download-cv .download-icon {
    transition: transform var(--transition-fast, 0.2s ease);
  }

  .btn-download-cv:hover .download-icon {
    transform: translateY(2px);
  }

  .btn-more-about {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-primary, #0f172a);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: all var(--transition-fast, 0.2s ease);
  }

  .btn-more-about:hover {
    background: #ffffff;
    border-color: var(--accent-primary, #0f172a);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
    transform: translateY(-1px);
  }

  .btn-more-about .arrow-icon {
    transition: transform var(--transition-fast, 0.2s ease);
  }

  .btn-more-about:hover .arrow-icon {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .polaroid-card {
      max-width: 220px;
    }

    .hero-title {
      font-size: clamp(1.75rem, 5.5vw, 2.15rem);
      line-height: 1.2;
    }

    .hero-role {
      font-size: 0.95rem;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
      width: 100%;
    }

    .btn-download-cv,
    .btn-more-about {
      width: 100%;
      justify-content: center;
      padding: 0.65rem 0.65rem;
      font-size: 0.84rem;
      text-align: center;
      white-space: nowrap;
    }
  }

  @media (max-width: 380px) {
    .polaroid-card {
      max-width: 190px;
    }
    .btn-download-cv,
    .btn-more-about {
      font-size: 0.78rem;
      padding: 0.6rem 0.4rem;
      gap: 0.35rem;
    }
  }

  /* BOTTOM ROW: 3-COLUMN GRID */
  .hero-bottom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.85);
    padding-top: 2.5rem;
    animation: heroSlideFade 0.95s 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (max-width: 980px) {
    .hero-bottom-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  .info-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1.65rem;
    background: rgba(255, 255, 255, 0.70);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-xl);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.035), inset 0 1px 1px rgba(255, 255, 255, 0.95);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-block:hover {
    background: rgba(255, 255, 255, 0.88);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -6px rgba(15, 23, 42, 0.06), inset 0 1px 1.5px rgba(255, 255, 255, 0.98);
  }

  .column-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-main);
    letter-spacing: -0.015em;
  }

  /* Education */
  .education-card {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .um-logo-wrapper {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
  }

  .um-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .education-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .institution-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-main);
    line-height: 1.3;
  }

  .education-major {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .education-period {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  /* Languages */
  .languages-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .language-row {
    display: grid;
    grid-template-columns: 85px 115px auto;
    align-items: center;
    font-size: 0.925rem;
  }

  .language-name {
    color: var(--text-main);
    font-weight: 500;
  }

  .language-proficiency {
    color: var(--text-muted);
  }

  .dot-rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot.filled {
    background-color: var(--text-main);
  }

  .dot.empty {
    border: 1.5px solid var(--text-main);
    background-color: transparent;
  }

  /* Experience */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .experience-item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .exp-period {
    display: flex;
    flex-direction: column;
    color: var(--text-main);
    font-weight: 500;
    font-size: 0.88rem;
  }

  .period-line {
    white-space: nowrap;
  }

  .exp-details {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .exp-company {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text-main);
  }

  .exp-role-type {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .divider {
    color: var(--text-light);
    margin: 0 0.15rem;
  }

  /* Softwares */
  .softwares-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .software-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    transition: transform var(--transition-fast);
  }

  .software-card:hover {
    transform: translateY(-3px);
  }

  .software-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05), inset 0 1px 1px rgba(255, 255, 255, 0.95);
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .software-card:hover .software-icon-wrapper {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  }

  .software-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .software-label {
    font-size: 0.68rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Contact Compact */
  .contact-compact-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.9rem;
  }

  .contact-compact-row {
    display: grid;
    grid-template-columns: 80px 14px 1fr;
    align-items: center;
  }

  .contact-label {
    color: var(--text-main);
    font-weight: 500;
  }

  .colon {
    color: var(--text-dim);
  }

  .contact-value {
    color: var(--text-muted);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .contact-value:hover {
    color: var(--text-main);
  }
</style>
