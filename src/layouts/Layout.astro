---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'id';
}

const {
  title = "Nanda Addi Wijaya | Videographer & Video Editor",
  description = "Official portfolio of Nanda Addi Wijaya - Videographer & Video Editor.",
  image = "/og-image.jpg",
  lang = "en"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://hi.nandaaddiwijaya.my.id';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(image, siteUrl);

const currentPath = Astro.url.pathname.replace(/^\/id/, '') || '/';
const idUrl = new URL(`/id${currentPath === '/' ? '' : currentPath}`, siteUrl);
const enUrl = new URL(currentPath, siteUrl);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Favicon & Touch Icons (Google Search & iOS Compliant) -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Web App Manifest (PWA) -->
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Theme Color for Mobile Browsers -->
  <meta name="theme-color" content="#0a0a0c" />
  <meta name="msapplication-TileColor" content="#0a0a0c" />

  <link rel="canonical" href={canonicalURL.href} />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Alternate Language Tags for Bilingual SEO -->
  <link rel="alternate" hreflang="id" href={idUrl.href} />
  <link rel="alternate" hreflang="en" href={enUrl.href} />
  <link rel="alternate" hreflang="x-default" href={enUrl.href} />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="author" content="Nanda Addi Wijaya" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nanda Addi Wijaya" />
  <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL.href} />
  <meta property="og:image:secure_url" content={socialImageURL.href} />
  <meta property="og:image:type" content={socialImageURL.href.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@nandaaddiwijaya" />
  <meta name="twitter:creator" content="@nandaaddiwijaya" />
  <meta name="twitter:url" content={canonicalURL.href} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL.href} />

  <!-- JSON-LD Structured Data (Schema.org Person & WebSite) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://hi.nandaaddiwijaya.my.id/#person",
        "name": "Nanda Addi Wijaya",
        "url": "https://hi.nandaaddiwijaya.my.id",
        "image": new URL("/images/profile.png", siteUrl).href,
        "jobTitle": "Videographer & Video Editor",
        "email": "hi@nandaaddiwijaya.my.id",
        "sameAs": [
          "https://www.instagram.com/nandaaddiwijaya",
          "https://www.linkedin.com/in/nandaaddiwijaya"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://hi.nandaaddiwijaya.my.id/#website",
        "url": "https://hi.nandaaddiwijaya.my.id",
        "name": "Nanda Addi Wijaya",
        "publisher": { "@id": "https://hi.nandaaddiwijaya.my.id/#person" },
        "inLanguage": lang
      }
    ]
  })} />

  <!-- Google Fonts Preconnect & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />

  <script>
    // Smooth scroll for internal anchor links with navbar offset
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('a[href^="#"]');
      if (target) {
        const href = target.getAttribute('href');
        if (href && href !== '#' && href.startsWith('#')) {
          const section = document.querySelector(href);
          if (section) {
            e.preventDefault();
            const yOffset = -72;
            const y = section.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
            history.pushState(null, '', href);
          }
        }
      }
    });
  </script>
</body>
</html>
