# ===================================================================
# Supabase Configuration (Dashboard -> Project Settings -> API)
# ===================================================================
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===================================================================
# Custom CDN Proxy Configuration
# ===================================================================
PUBLIC_CDN_DOMAIN=hello.nandaaddiwijaya.my.id

# ===================================================================
# GitHub Asset Storage (Server-Side Upload via .env)
# Token never exposed to browser frontend!
# ===================================================================
GITHUB_ACCESS_TOKEN=github_pat_your_token_here
GITHUB_REPO_OWNER=NandaAddi
GITHUB_REPO_NAME=portfolio-assets
GITHUB_BRANCH=main

# ===================================================================
# Static Site Rebuild Trigger (Optional)
# ===================================================================
# PUBLIC_DEPLOY_WEBHOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...
